{
  "manifest_version": 3,
  "name": "LeetCode AI Solver",
  "version": "1.0.0",
  "description": "Self-correcting AI that solves LeetCode problems automatically",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:8000/*"
  ],

  "action": {
    "default_popup" : "popup.html",
    "default_title" : "LeetCode AI Solver"
  },

  "content_scripts": [
    {
      "matches" : ["https://leetcode.com/problems/*"],
      "js"      : ["content.js"],
      "run_at"  : "document_idle"
    }
  ],

  "icons": {
    "16"  : "icons/icon16.png",
    "48"  : "icons/icon48.png",
    "128" : "icons/icon128.png"
  }
}